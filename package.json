{
  "name": "season-shelf",
  "productName": "Season Shelf",
  "version": "0.1.0",
  "description": "A local desktop companion for organising episodic Telegram downloads.",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "big-integer": "1.6.52",
    "electron-updater": "6.8.9",
    "teleproto": "1.229.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "jsdom": "30.0.1"
  },
  "build": {
    "appId": "local.seasonshelf.desktop",
    "productName": "Season Shelf",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/desktop/assets/icon.ico"
    },
    "artifactName": "Season-Shelf-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Harshana-Rathnayaka",
      "repo": "season-shelf",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Harshana-Rathnayaka/season-shelf.git"
  }
}
