{
  "name": "season-shelf",
  "productName": "Season Shelf",
  "version": "1.2.0",
  "description": "A local desktop companion for organising episodic Telegram downloads.",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs && npm run typecheck && npm run build",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "pack:mac": "electron-builder --mac dmg zip --universal --publish never",
    "release:mac": "electron-builder --mac dmg zip --universal --publish always",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "predev": "npm run build",
    "prepack:win": "npm run build",
    "prepack:mac": "npm run build",
    "prerelease:win": "npm run build",
    "prerelease:mac": "npm run build",
    "prepreview": "npm run build"
  },
  "dependencies": {
    "big-integer": "1.6.52",
    "electron-updater": "6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "teleproto": "1.229.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "local.seasonshelf.desktop",
    "productName": "Season Shelf",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "dist/ui/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/desktop/assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "artifactName": "Season-Shelf-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Harshana-Rathnayaka",
      "repo": "season-shelf",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "src/desktop/assets/icon.icns",
      "artifactName": "Season-Shelf-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "notarize": false,
      "identity": null
    },
    "extraMetadata": {
      "appEnvironment": "production"
    },
    "beforePack": "build/validate-environment.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Harshana-Rathnayaka/season-shelf.git"
  },
  "license": "MIT"
}
